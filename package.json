{
  "name": "@qinglvsenlin/copyright-compliance",
  "version": "1.0.0",
  "description": "软件版权合规安全骨架：设备激活上限校验 + 电子签SHA-256哈希存证（零信任、纯TS）",
  "keywords": [
    "copyright",
    "license-compliance",
    "zero-trust",
    "esign",
    "device-activation",
    "sha256",
    "postgres",
    "row-lock",
    "anti-tamper"
  ],
  "homepage": "https://github.com/YOUR_USERNAME/qinglvsenlin-copyright",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/qinglvsenlin-copyright"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "author": {
    "name": "qinglvsenlin contributors"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:demo": "mkdir -p dist && esbuild src/index.ts --bundle --format=iife --global-name=Desens --outfile=dist/index.js --log-level=warning && cp demo/index.html dist/index.html",
    "build": "pnpm run build:demo"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}